{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.stratum.my/schemas/resource.schema.json",
  "title": "Malaysia Data Directory Resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "publisher",
    "description",
    "categories",
    "access",
    "endpoints",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "access": {
      "$ref": "#/$defs/access"
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "geography": {
      "$ref": "#/$defs/geography"
    },
    "temporal": {
      "$ref": "#/$defs/temporal"
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/endpoint"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "related_resources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "open",
            "public",
            "register",
            "request",
            "research",
            "paid",
            "restricted",
            "unknown"
          ]
        },
        "registration_required": {
          "type": "boolean"
        },
        "paid": {
          "type": "boolean"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "verified": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "granularity": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "end": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "frequency": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discovered_from": {
          "type": "string",
          "format": "uri"
        },
        "external_id": {
          "type": "string"
        },
        "discovered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "label": {
          "type": "string"
        },
        "documentation": {
          "type": "string",
          "format": "uri"
        },
        "format": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "auth": {
          "enum": [
            "none",
            "api_key",
            "oauth",
            "account",
            "application",
            "institutional",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
