{
  "name": "malaysia-data",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An open catalogue of Malaysian data resources — metadata only. An open project by Stratum.",
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "catalogue": "tsx scripts/build-exports.ts",
    "validate": "tsx scripts/validate.ts",
    "check:catalogue": "tsx scripts/validate.ts --strict-export",
    "check:links": "tsx scripts/check-links.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
